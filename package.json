    "@vitest/ui": "^4.1.9",
    "arweave": "^1.15.7",
    "axios": "^1.18.0",
    "c8": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "hastscript": "^9.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "notion-to-md": "3.1.9",
    "null-loader": "^4.0.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "{!(scripts)/**/*,*}.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
