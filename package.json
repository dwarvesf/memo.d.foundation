    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "viem": "2.x",
    "wagmi": "^2"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@eslint/eslintrc": "^3.3.5",
    "@notionhq/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
