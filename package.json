    "recharts": "^3.8.1",
    "recma-mdx-escape-missing-components": "^1.2.5",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
